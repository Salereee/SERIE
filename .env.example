# Copia este archivo a .env.production.local (no se sube a git) o define las variables en Cloudflare.
# Nada de esto es secreto: todo termina en el HTML público.

# URL pública del sitio, sin barra final (p. ej. https://serie.pages.dev). Hace absolutas la imagen
# Open Graph, canonical, og:url y el JSON-LD. Vacía = rutas relativas y sin sitemap.
VITE_SITE_URL=

# true = permitir buscadores. Vacío = noindex.
# Con VITE_SITE_URL definida, además genera sitemap.xml (/ y /inicio/) y lo anuncia en robots.txt.
ALLOW_INDEXING=

# true = publicar source maps.
SOURCEMAP=

# Token público de Cloudflare Web Analytics. Vacío = sin analítica.
# Si lo activas, cambia también la CSP en public/_headers (hay una alternativa comentada).
VITE_CF_ANALYTICS_TOKEN=
